# Copy to .env (same folder as docker-compose.prod.yml) and fill in.
# .env itself is gitignored - never commit real values here.

GHCR_OWNER=tvoj-github-username
GHCR_REPO=barcode-to-qr

# Which image tag to deploy: "main" (latest from main branch), a short
# git SHA, or a semver like "1.2.0" (pushed automatically by CI on a
# "v1.2.0" git tag).
IMAGE_TAG=main

# Port on the HOST machine that nginx/frontend listens on.
FRONTEND_PORT=8081

# Comma-separated origins the backend trusts for direct API access
# (not needed for normal use - the frontend nginx proxies same-origin).
CORS_ALLOWED_ORIGINS=http://localhost:8081

LOG_LEVEL=INFO
